{
  // UNTESTED. Field names follow the Cloudflare Containers docs as read on the
  // day this was written; see README.md in this folder for what to verify.
  "name": "rainwise",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "containers": [
    {
      "class_name": "RainwiseContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RAINWISE", "class_name": "RainwiseContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RainwiseContainer"] }],
  // Every 30 minutes (scheduler.sync_every): create a sync job. Keeping the
  // container awake during a job is done by the Container class. A 409
  // automation_disabled is expected until you opt in.
  "triggers": { "crons": ["*/30 * * * *"] }
  // Secrets (set with `wrangler secret put NAME`), all passed on to the container:
  //   RAINWISE_API_TOKEN, RAINDROP_TOKEN, RAINDROP_WEBHOOK_SECRET, RAINWISE_MODEL,
  //   OPENROUTER_API_KEY, LITESTREAM_BUCKET, LITESTREAM_ENDPOINT,
  //   LITESTREAM_ACCESS_KEY_ID, LITESTREAM_SECRET_ACCESS_KEY
}
